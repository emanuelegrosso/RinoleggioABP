@page "/Admin/DeletedListings"
@model Rinoleggio.Web.Pages.Admin.DeletedListings.IndexModel

<h1 class="mb-3">Annunci eliminati</h1>
<p class="text-muted">Qui puoi ripristinare un annuncio cancellato. Gli annunci con contratto scaduto torneranno in bozza.</p>
@if (Model.Listings.TotalCount == 0)
{
    <div class="alert alert-info">Non ci sono annunci eliminati da ripristinare.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Annuncio</th><th>Dealer</th><th>Motivo cancellazione</th><th>Fine contratto</th><th></th></tr></thead><tbody>
    @foreach (var listing in Model.Listings.Items)
    {
        <tr><td>@listing.Title<div class="small text-muted">@listing.Brand @listing.Model · @listing.Province</div></td><td><code>@listing.OwnerId</code></td><td>@listing.StatusReason</td><td>@listing.EndDate.ToString("dd/MM/yyyy")</td><td><form method="post" asp-page-handler="Restore"><input type="hidden" name="id" value="@listing.Id" /><input type="hidden" name="SkipCount" value="@Model.SkipCount" /><button class="btn btn-sm btn-primary">Ripristina</button></form></td></tr>
    }
    </tbody></table></div>
    <nav class="mt-4 d-flex justify-content-between" aria-label="Paginazione annunci eliminati">
        <a class="btn btn-outline-secondary @(Model.SkipCount == 0 ? "disabled" : "")" aria-disabled="@(Model.SkipCount == 0)" href="?skipCount=@Model.PreviousSkipCount">Precedente</a>
        <span class="align-self-center">Pagina @Model.PageNumber di @Model.PageCount</span>
        <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")" aria-disabled="@(!Model.HasNextPage)" href="?skipCount=@Model.NextSkipCount">Successiva</a>
    </nav>
}
