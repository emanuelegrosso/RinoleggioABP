@page "/My/Listings/Create"
@model Rinoleggio.Web.Pages.My.Listings.CreateModel
<h1>Inserisci contratto</h1>
<form method="post" enctype="multipart/form-data" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <h2 class="h5">Annuncio</h2><div class="row g-3">
    <div class="col-md-6"><label asp-for="Input.Title" class="form-label">Titolo</label><input asp-for="Input.Title" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Province" class="form-label">Provincia</label><input asp-for="Input.Province" list="province-options" class="form-control" /><datalist id="province-options">@foreach (var value in Model.Provinces) { <option value="@value"></option> }</datalist></div>
    <div class="col-12"><label asp-for="Input.Description" class="form-label">Descrizione</label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><label asp-for="UploadPhotos" class="form-label">Foto del veicolo</label><input asp-for="UploadPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple class="form-control" /><div class="form-text">JPEG, PNG o WebP. Massimo 5 foto per caricamento, 4 MB ciascuna.</div><span asp-validation-for="UploadPhotos" class="text-danger"></span></div>
    </div><hr /><h2 class="h5">Veicolo</h2><div class="row g-3">
    <div class="col-md-3"><label asp-for="Input.Brand" class="form-label">Marca</label><input asp-for="Input.Brand" list="brand-options" class="form-control" /><datalist id="brand-options">@foreach (var value in Model.Brands) { <option value="@value"></option> }</datalist></div><div class="col-md-3"><label asp-for="Input.Model" class="form-label">Modello</label><input asp-for="Input.Model" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Version" class="form-label">Versione</label><input asp-for="Input.Version" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.RegistrationYear" class="form-label">Anno</label><input asp-for="Input.RegistrationYear" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Input.FuelType" class="form-label">Alimentazione</label><select asp-for="Input.FuelType" asp-items="Html.GetEnumSelectList<FuelType>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="Input.Transmission" class="form-label">Cambio</label><select asp-for="Input.Transmission" asp-items="Html.GetEnumSelectList<TransmissionType>()" class="form-select"></select></div>
    </div><hr /><h2 class="h5">Contratto e servizi</h2><div class="row g-3">
    <div class="col-md-4"><label asp-for="Input.RentalCompany" class="form-label">Società di noleggio</label><input asp-for="Input.RentalCompany" list="rental-company-options" class="form-control" /><datalist id="rental-company-options">@foreach (var value in Model.RentalCompanies) { <option value="@value"></option> }</datalist></div><div class="col-md-4"><label asp-for="Input.MonthlyFee" class="form-label">Canone mensile (€)</label><input asp-for="Input.MonthlyFee" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.InitialPayment" class="form-label">Anticipo (€)</label><input asp-for="Input.InitialPayment" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Input.StartDate" class="form-label">Inizio</label><input asp-for="Input.StartDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.EndDate" class="form-label">Scadenza</label><input asp-for="Input.EndDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.TotalKm" class="form-label">Km totali</label><input asp-for="Input.TotalKm" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.CurrentKm" class="form-label">Km attuali</label><input asp-for="Input.CurrentKm" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Input.ContributionType" class="form-label">Contributo subentro</label><select asp-for="Input.ContributionType" asp-items="Html.GetEnumSelectList<ContributionType>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="Input.ContributionAmount" class="form-label">Importo contributo (€)</label><input asp-for="Input.ContributionAmount" class="form-control" /></div>
    <div class="col-md-3"><div class="form-check"><input asp-for="Input.VatIncluded" class="form-check-input" /><label asp-for="Input.VatIncluded" class="form-check-label">IVA inclusa</label></div></div>
    <div class="col-md-3"><div class="form-check"><input asp-for="Input.MaintenanceIncluded" class="form-check-input" /><label asp-for="Input.MaintenanceIncluded" class="form-check-label">Manutenzione</label></div></div><div class="col-md-3"><div class="form-check"><input asp-for="Input.InsuranceIncluded" class="form-check-input" /><label asp-for="Input.InsuranceIncluded" class="form-check-label">Assicurazione</label></div></div><div class="col-md-3"><div class="form-check"><input asp-for="Input.RoadsideAssistanceIncluded" class="form-check-input" /><label asp-for="Input.RoadsideAssistanceIncluded" class="form-check-label">Assistenza stradale</label></div></div>
    <div class="col-md-3"><div class="form-check"><input asp-for="Input.ReplacementCarIncluded" class="form-check-input" /><label asp-for="Input.ReplacementCarIncluded" class="form-check-label">Auto sostitutiva</label></div></div><div class="col-md-3"><div class="form-check"><input asp-for="Input.TiresIncluded" class="form-check-input" /><label asp-for="Input.TiresIncluded" class="form-check-label">Pneumatici</label></div></div><div class="col-md-3"><div class="form-check"><input asp-for="Input.RoadTaxIncluded" class="form-check-input" /><label asp-for="Input.RoadTaxIncluded" class="form-check-label">Bollo</label></div></div><div class="col-md-3"><label asp-for="Input.InsuranceKinds" class="form-label">Coperture (testo libero)</label><input asp-for="Input.InsuranceKinds" class="form-control" /></div>
    </div><hr /><div class="form-check mb-3"><input asp-for="Input.Publish" class="form-check-input" /><label asp-for="Input.Publish" class="form-check-label">Pubblica subito</label></div><button class="btn btn-primary">Salva annuncio</button>
</form>
