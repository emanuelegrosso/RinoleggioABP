@page "/My/Listings"
@using Rinoleggio.Listings
@model Rinoleggio.Web.Pages.My.Listings.IndexModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1>I miei annunci</h1><p class="text-muted">Gestisci pubblicazione, modifiche e disponibilità.</p></div>
    @if (Model.CanCreate) { <a class="btn btn-primary" href="/My/Listings/Create">Nuovo annuncio</a> }
</div>

@if (Model.Listings.TotalCount == 0)
{
    <div class="alert alert-info">Non hai ancora annunci. @if (Model.CanCreate) { <a href="/My/Listings/Create">Pubblica un’offerta</a> }</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Annuncio</th><th>Canone</th><th>Scadenza</th><th>Stato</th><th>Azioni</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Listings.Items)
        {
            <tr>
                <td>@item.Title<br /><small>@item.Brand @item.Model</small></td>
                <td>@item.MonthlyFee.ToString("C0")</td>
                <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                <td>@item.Status@if (!string.IsNullOrEmpty(item.StatusReason)) { <div class="small text-muted">@item.StatusReason</div> }</td>
                <td>
                    @if (Model.CanManage)
                    {
                        <a href="/My/Listings/Edit/@item.Id" class="btn btn-sm btn-outline-primary mb-1">Modifica</a>
                        @if (item.Status is ListingStatus.Active or ListingStatus.Reserved or ListingStatus.Withdrawn)
                        {
                            <form method="post" asp-page-handler="SetStatus" class="d-flex flex-wrap gap-1">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="SkipCount" value="@Model.SkipCount" />
                                <select name="status" class="form-select form-select-sm" style="max-width:150px">
                                    <option value="" selected disabled>Seleziona</option>
                                    @if (item.Status == ListingStatus.Withdrawn) { <option value="Active">Ripubblica</option> }
                                    @if (item.Status == ListingStatus.Reserved) { <option value="Active">Disponibile</option> }
                                    <option value="Reserved">Riservato</option><option value="Closed">Chiuso</option>
                                    <option value="Withdrawn">Ritira</option><option value="Deleted">Elimina</option>
                                </select>
                                <input name="reason" class="form-control form-control-sm" style="max-width:180px" placeholder="Motivo eliminazione" />
                                <button class="btn btn-sm btn-outline-secondary">Aggiorna</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
    <nav class="mt-4 d-flex justify-content-between" aria-label="Paginazione annunci">
        <a class="btn btn-outline-secondary @(Model.SkipCount == 0 ? "disabled" : "")" aria-disabled="@(Model.SkipCount == 0)" href="?skipCount=@Model.PreviousSkipCount">Precedente</a>
        <span class="align-self-center">Pagina @Model.PageNumber di @Model.PageCount</span>
        <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")" aria-disabled="@(!Model.HasNextPage)" href="?skipCount=@Model.NextSkipCount">Successiva</a>
    </nav>
}
