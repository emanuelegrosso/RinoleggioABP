@page "/My/Requests"
@model Rinoleggio.Web.Pages.My.Requests.IndexModel

<h1 class="mb-3">Le mie richieste</h1>
<p class="text-muted">Le richieste che hai inviato ai dealer.</p>
@if (Model.RequestSubmitted) { <div class="alert alert-success" role="status">Richiesta inviata. Il team Rinoleggio la prenderà in carico e potrai seguirne qui lo stato.</div> }

@if (Model.Requests.TotalCount == 0)
{
    <div class="alert alert-info">Non hai ancora inviato richieste. <a href="/Listings">Cerca un contratto</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Annuncio</th><th>Dealer</th><th>Messaggio</th><th>Stato</th><th>Data</th></tr></thead>
            <tbody>
            @foreach (var request in Model.Requests.Items)
            {
                <tr>
                    <td>
                        @if (request.ListingAvailable)
                        {
                            <a href="/Listings/Details/@request.ListingId">@request.ListingTitle</a>
                        }
                        else
                        {
                            <span>@request.ListingTitle</span><div class="small text-muted">Annuncio non più disponibile</div>
                        }
                    </td>
                    <td>@request.DealerDisplayName</td>
                    <td>@request.Message</td>
                    <td>@request.Status</td>
                    <td>@request.CreationTime.ToLocalTime().ToString("dd/MM/yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="mt-4 d-flex justify-content-between" aria-label="Paginazione richieste">
        <a class="btn btn-outline-secondary @(Model.SkipCount == 0 ? "disabled" : "")" aria-disabled="@(Model.SkipCount == 0)" href="?skipCount=@Model.PreviousSkipCount">Precedente</a>
        <span class="align-self-center">Pagina @Model.PageNumber di @Model.PageCount</span>
        <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")" aria-disabled="@(!Model.HasNextPage)" href="?skipCount=@Model.NextSkipCount">Successiva</a>
    </nav>
}
