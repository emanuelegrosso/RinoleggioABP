@page "/Listings/Details/{id:guid}"
@using Rinoleggio.Listings
@model Rinoleggio.Web.Pages.Listings.DetailsModel
<a href="/Listings" class="text-decoration-none">← Torna alla ricerca</a>
<div class="row mt-3 g-4"><div class="col-lg-7">
    @{
        var images = (Model.Listing.ImageUrls ?? string.Empty).Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var carouselId = $"listing-gallery-{Model.Listing.Id:N}";
    }
    @if (images.Length > 0)
    {
        <div id="@carouselId" class="carousel slide rounded overflow-hidden bg-light" data-bs-ride="false" aria-label="Foto di @Model.Listing.Title">
            <div class="carousel-inner">
                @for (var i = 0; i < images.Length; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@images[i]" class="d-block w-100" style="height:460px;object-fit:contain" alt="@Model.Listing.Title — foto @(i + 1) di @images.Length" />
                    </div>
                }
            </div>
            @if (images.Length > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" aria-label="Foto precedente"><span class="carousel-control-prev-icon" aria-hidden="true"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next" aria-label="Foto successiva"><span class="carousel-control-next-icon" aria-hidden="true"></span></button>
                <div class="carousel-indicators">
                    @for (var i = 0; i < images.Length; i++)
                    {
                        <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Mostra foto @(i + 1)" aria-current="@(i == 0 ? "true" : null)"></button>
                    }
                </div>
            }
        </div>
    }
    <h1>@Model.Listing.Title</h1><p>@Model.Listing.Description</p>
</div><div class="col-lg-5"><div class="card"><div class="card-body">
    <div class="h2">@Model.Listing.MonthlyFee.ToString("C2") <small class="fs-6">/ mese</small></div><p>@Model.Listing.RentalCompany · @Model.Listing.Province</p>
    <hr />
    <h2 class="h6">Veicolo</h2>
    <dl class="row">
        <dt class="col-6">Modello</dt><dd class="col-6">@Model.Listing.Brand @Model.Listing.Model @Model.Listing.Version</dd>
        <dt class="col-6">Anno</dt><dd class="col-6">@Model.Listing.RegistrationYear</dd>
        <dt class="col-6">Alimentazione</dt><dd class="col-6">@Model.Listing.FuelType</dd>
        <dt class="col-6">Cambio</dt><dd class="col-6">@Model.Listing.Transmission</dd>
    </dl>
    <h2 class="h6 mt-3">Condizioni del contratto</h2>
    <dl class="row">
        @if (Model.Listing.StartDate.HasValue) { <dt class="col-6">Inizio contratto</dt><dd class="col-6">@Model.Listing.StartDate.Value.ToString("dd/MM/yyyy")</dd> }
        <dt class="col-6">Scadenza</dt><dd class="col-6">@Model.Listing.EndDate.ToString("dd/MM/yyyy")</dd>
        <dt class="col-6">Km totali</dt><dd class="col-6">@Model.Listing.TotalKm.ToString("N0")</dd>
        <dt class="col-6">Km percorsi</dt><dd class="col-6">@Model.Listing.CurrentKm.ToString("N0")</dd>
        <dt class="col-6">Km residui</dt><dd class="col-6">@Model.Listing.RemainingKm.ToString("N0")</dd>
        <dt class="col-6">Anticipo</dt><dd class="col-6">@Model.Listing.InitialPayment.ToString("C2")</dd>
        <dt class="col-6">IVA inclusa</dt><dd class="col-6">@(Model.Listing.VatIncluded ? "Sì" : "No")</dd>
        @if (Model.Listing.ExcessKmRate.HasValue) { <dt class="col-6">Costo km in eccesso</dt><dd class="col-6">@Model.Listing.ExcessKmRate.Value.ToString("C2") / km</dd> }
        @if (Model.Listing.UnderKmRate.HasValue) { <dt class="col-6">Rimborso km non percorsi</dt><dd class="col-6">@Model.Listing.UnderKmRate.Value.ToString("C2") / km</dd> }
        @if (Model.Listing.ContributionType != ContributionType.None || Model.Listing.ContributionAmount > 0)
        {
            <dt class="col-6">Contributo subentro</dt><dd class="col-6">@Model.Listing.ContributionType · @Model.Listing.ContributionAmount.ToString("C2")</dd>
        }
    </dl>
    <h2 class="h6 mt-3">Servizi inclusi</h2>
    <div class="d-flex flex-wrap gap-2 mb-3">
        @if (Model.Listing.MaintenanceIncluded) { <span class="badge text-bg-light">Manutenzione</span> }
        @if (Model.Listing.InsuranceIncluded) { <span class="badge text-bg-light">Assicurazione</span> }
        @if (Model.Listing.RoadsideAssistanceIncluded) { <span class="badge text-bg-light">Assistenza stradale</span> }
        @if (Model.Listing.ReplacementCarIncluded) { <span class="badge text-bg-light">Auto sostitutiva</span> }
        @if (Model.Listing.TiresIncluded) { <span class="badge text-bg-light">Pneumatici</span> }
        @if (Model.Listing.RoadTaxIncluded) { <span class="badge text-bg-light">Bollo</span> }
        @if (!Model.Listing.MaintenanceIncluded && !Model.Listing.InsuranceIncluded && !Model.Listing.RoadsideAssistanceIncluded && !Model.Listing.ReplacementCarIncluded && !Model.Listing.TiresIncluded && !Model.Listing.RoadTaxIncluded) { <span class="text-muted">Nessun servizio incluso indicato.</span> }
    </div>
    @if (Model.Listing.InsuranceIncluded && !string.IsNullOrWhiteSpace(Model.Listing.InsuranceKinds)) { <p class="small"><strong>Coperture assicurative:</strong> @Model.Listing.InsuranceKinds</p> }
    @if (Model.Listing.Status == ListingStatus.Active) { <a class="btn btn-primary w-100" href="/Listings/Request/@Model.Listing.Id">Richiedi questo contratto</a> } else { <button class="btn btn-secondary w-100" disabled>Riservato</button> }
</div></div></div></div>
