@page "/Listings/Request/{listingId:guid}"
@model Rinoleggio.Web.Pages.Listings.RequestModel
<h1>Richiedi questo contratto</h1>
<div class="alert alert-light">@Model.Listing.Title · @Model.Listing.MonthlyFee.ToString("C0") al mese · scadenza @Model.Listing.EndDate.ToString("dd/MM/yyyy")</div>
<form method="post" class="card card-body" style="max-width:720px"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Input.Message" class="form-label">Messaggio</label><textarea asp-for="Input.Message" class="form-control" rows="5"></textarea><span asp-validation-for="Input.Message" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.BuyerPhone" class="form-label">Telefono (facoltativo, visibile al team)</label><input asp-for="Input.BuyerPhone" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="Input.PrivacyConsent" class="form-check-input" /><label asp-for="Input.PrivacyConsent" class="form-check-label">Acconsento al trattamento dei dati per gestire questa richiesta. <a href="/Privacy" target="_blank" rel="noopener">Leggi l’informativa privacy</a>.</label><span asp-validation-for="Input.PrivacyConsent" class="text-danger"></span></div>
    <button class="btn btn-primary">Invia richiesta</button>
</form>
