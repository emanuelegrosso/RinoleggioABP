@page "/BackOffice/Leads"
@using Rinoleggio.Listings
@model Rinoleggio.Web.Pages.BackOffice.Leads.IndexModel

<h1 class="mb-3">Gestione richieste</h1>
<p class="text-muted">@Model.Requests.TotalCount richieste. Recapiti e note sono visibili solo in quest’area.</p>
<p class="text-muted">Il contatto tra cliente, dealer e società di noleggio avviene fuori dalla piattaforma; qui puoi registrare l’esito e aggiornare lo stato dell’offerta.</p>
@if (TempData["UpdateError"] is string error) { <div class="alert alert-warning">@error</div> }

<form method="get" class="card card-body mb-3">
    <input type="hidden" name="skipCount" value="0" />
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="lead-status-filter">Stato richiesta</label>
            <select id="lead-status-filter" name="Status" class="form-select">
                <option value="">Tutte</option>
                <option value="New" selected="@(Model.Status == LeadStatus.New)">Nuova</option>
                <option value="Contacted" selected="@(Model.Status == LeadStatus.Contacted)">Contattata</option>
                <option value="Closed" selected="@(Model.Status == LeadStatus.Closed)">Chiusa</option>
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-primary">Filtra</button> <a href="/BackOffice/Leads" class="btn btn-outline-secondary">Azzera</a></div>
    </div>
</form>

@if (Model.Requests.TotalCount == 0)
{
    <div class="alert alert-info">Nessuna richiesta presente.</div>
}
else
{
    <div class="row g-3">
    @foreach (var request in Model.Requests.Items)
    {
        <div class="col-12">
            <article class="card"><div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <h2 class="h5"><a href="/BackOffice/Listings/Details/@request.ListingId">@request.ListingTitle</a></h2>
                    <div><span class="badge text-bg-secondary">Richiesta: @request.Status</span> @if (request.CurrentListingStatus.HasValue) { <span class="badge text-bg-light">Offerta: @request.CurrentListingStatus</span> }</div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><strong>Cliente:</strong> @request.BuyerDisplayName<br />
                        @if (!string.IsNullOrWhiteSpace(request.BuyerEmail)) { <a href="mailto:@request.BuyerEmail">@request.BuyerEmail</a><br /> }
                        @if (!string.IsNullOrWhiteSpace(request.BuyerPhone)) { <span>Telefono richiesta: @request.BuyerPhone</span><br /> }
                        @if (!string.IsNullOrWhiteSpace(request.BuyerAccountPhoneNumber)) { <span>Telefono profilo: @request.BuyerAccountPhoneNumber</span> }
                    </div>
                    <div class="col-md-6"><strong>Dealer:</strong> @request.SellerDisplayName<br />
                        @if (!string.IsNullOrWhiteSpace(request.SellerEmail)) { <a href="mailto:@request.SellerEmail">@request.SellerEmail</a><br /> }
                        @if (!string.IsNullOrWhiteSpace(request.SellerPhoneNumber)) { <span>@request.SellerPhoneNumber</span> }
                    </div>
                </div>
                <p class="mb-3">@request.Message</p>
                @if (Model.CanManage)
                {
                    <form method="post" asp-page-handler="Update" asp-route-id="@request.Id" class="row g-2 align-items-end">
                        <input type="hidden" name="SkipCount" value="@Model.SkipCount" />
                        <input type="hidden" name="Status" value="@Model.Status" />
                        <div class="col-md-2"><label class="form-label">Stato richiesta</label><select name="Input.Status" class="form-select"><option value="Contacted" selected="@(request.Status != LeadStatus.Closed ? "selected" : null)">Presa in carico</option><option value="Closed" selected="@(request.Status == LeadStatus.Closed ? "selected" : null)">Chiusa</option></select></div>
                        <div class="col-md-3"><label class="form-label">Esito</label><select name="Input.Outcome" class="form-select"><option value="None" selected="@(request.Outcome == LeadOutcome.None ? "selected" : null)">Da definire</option><option value="TransferCompleted" selected="@(request.Outcome == LeadOutcome.TransferCompleted ? "selected" : null)">Subentro completato</option><option value="CustomerDeclined" selected="@(request.Outcome == LeadOutcome.CustomerDeclined ? "selected" : null)">Cliente rinuncia</option><option value="DealerDeclined" selected="@(request.Outcome == LeadOutcome.DealerDeclined ? "selected" : null)">Dealer rinuncia</option><option value="NotEligible" selected="@(request.Outcome == LeadOutcome.NotEligible ? "selected" : null)">Requisiti non soddisfatti</option><option value="ContractUnavailable" selected="@(request.Outcome == LeadOutcome.ContractUnavailable ? "selected" : null)">Contratto non disponibile</option><option value="Other" selected="@(request.Outcome == LeadOutcome.Other ? "selected" : null)">Altro</option></select></div>
                        <div class="col-md-3"><label class="form-label">Stato dell’offerta</label><select name="Input.ListingStatus" class="form-select"><option value="">Non modificare (@request.CurrentListingStatus)</option><option value="Active">Disponibile</option><option value="Reserved">Riservato</option><option value="Closed">Chiuso</option></select></div>
                        <div class="col-md-4"><label class="form-label">Dettagli esito</label><input name="Input.OutcomeNotes" value="@request.OutcomeNotes" maxlength="1000" class="form-control" /></div>
                        <div class="col-md-10"><label class="form-label">Note interne</label><input name="Input.InternalNotes" value="@request.InternalNotes" maxlength="4000" class="form-control" /></div>
                        <div class="col-md-2"><button class="btn btn-primary w-100">Salva e notifica</button></div>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(request.InternalNotes)) { <div class="small text-muted mt-2">Note attuali: @request.InternalNotes</div> }
                }
                <div class="small text-muted mt-2">Ricevuta il @request.CreationTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div></article>
        </div>
    }
    </div>
    <nav class="mt-4 d-flex justify-content-between" aria-label="Paginazione richieste">
        <a class="btn btn-outline-secondary @(Model.SkipCount == 0 ? "disabled" : "")" aria-disabled="@(Model.SkipCount == 0)" href="?skipCount=@Model.PreviousSkipCount&amp;status=@Model.Status">Precedente</a>
        <span class="align-self-center">Pagina @Model.PageNumber di @Model.PageCount</span>
        <a class="btn btn-outline-secondary @(!Model.HasNextPage ? "disabled" : "")" aria-disabled="@(!Model.HasNextPage)" href="?skipCount=@Model.NextSkipCount&amp;status=@Model.Status">Successiva</a>
    </nav>
}
