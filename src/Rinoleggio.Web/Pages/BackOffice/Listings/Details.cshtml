@page "/BackOffice/Listings/Details/{id:guid}"
@using Rinoleggio.Listings
@model Rinoleggio.Web.Pages.BackOffice.Listings.DetailsModel

<a href="/BackOffice/Listings" class="text-decoration-none">← Torna alla gestione offerte</a>
<div class="d-flex justify-content-between align-items-start mt-3 mb-3">
    <div><h1>@Model.Listing.Title</h1><span class="badge text-bg-secondary">@Model.Listing.Status</span>
        @if (!string.IsNullOrWhiteSpace(Model.Listing.StatusReason)) { <p class="text-muted mt-2">Motivo: @Model.Listing.StatusReason</p> }
    </div>
    @if (Model.CanManage && Model.Listing.Status != ListingStatus.Deleted) { <a class="btn btn-outline-primary" href="/My/Listings/Edit/@Model.Listing.Id">Modifica annuncio</a> }
</div>
<div class="row g-4">
    <div class="col-lg-7">
        @{
            var images = (Model.Listing.ImageUrls ?? string.Empty).Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var carouselId = $"backoffice-listing-gallery-{Model.Listing.Id:N}";
        }
        @if (images.Length > 0)
        {
            <div id="@carouselId" class="carousel slide rounded overflow-hidden bg-light" data-bs-ride="false" aria-label="Foto di @Model.Listing.Title">
                <div class="carousel-inner">
                    @for (var i = 0; i < images.Length; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")"><img src="@images[i]" class="d-block w-100" style="height:460px;object-fit:contain" alt="@Model.Listing.Title — foto @(i + 1) di @images.Length" /></div>
                    }
                </div>
                @if (images.Length > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev" aria-label="Foto precedente"><span class="carousel-control-prev-icon" aria-hidden="true"></span></button>
                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next" aria-label="Foto successiva"><span class="carousel-control-next-icon" aria-hidden="true"></span></button>
                    <div class="carousel-indicators">
                        @for (var i = 0; i < images.Length; i++)
                        {
                            <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Mostra foto @(i + 1)" aria-current="@(i == 0 ? "true" : null)"></button>
                        }
                    </div>
                }
            </div>
        }
        <div class="card card-body mt-3">
            <h2 class="h5">Descrizione</h2><p>@Model.Listing.Description</p>
            <h3 class="h6 mt-2">Annuncio e veicolo</h3>
            <dl class="row">
                <dt class="col-5">Dealer ID</dt><dd class="col-7"><code>@Model.Listing.OwnerId</code></dd>
                <dt class="col-5">Società</dt><dd class="col-7">@Model.Listing.RentalCompany</dd>
                <dt class="col-5">Provincia</dt><dd class="col-7">@Model.Listing.Province</dd>
                <dt class="col-5">Veicolo</dt><dd class="col-7">@Model.Listing.Brand @Model.Listing.Model @Model.Listing.Version</dd>
                <dt class="col-5">Anno</dt><dd class="col-7">@Model.Listing.RegistrationYear</dd>
                <dt class="col-5">Alimentazione</dt><dd class="col-7">@Model.Listing.FuelType</dd>
                <dt class="col-5">Cambio</dt><dd class="col-7">@Model.Listing.Transmission</dd>
            </dl>
            <h3 class="h6 mt-2">Condizioni del contratto</h3>
            <dl class="row">
                @if (Model.Listing.StartDate.HasValue) { <dt class="col-5">Inizio</dt><dd class="col-7">@Model.Listing.StartDate.Value.ToString("dd/MM/yyyy")</dd> }
                <dt class="col-5">Fine</dt><dd class="col-7">@Model.Listing.EndDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-5">Canone</dt><dd class="col-7">@Model.Listing.MonthlyFee.ToString("C2")</dd>
                <dt class="col-5">Anticipo</dt><dd class="col-7">@Model.Listing.InitialPayment.ToString("C2")</dd>
                <dt class="col-5">IVA inclusa</dt><dd class="col-7">@(Model.Listing.VatIncluded ? "Sì" : "No")</dd>
                <dt class="col-5">Km totali</dt><dd class="col-7">@Model.Listing.TotalKm.ToString("N0")</dd>
                <dt class="col-5">Km percorsi</dt><dd class="col-7">@Model.Listing.CurrentKm.ToString("N0")</dd>
                <dt class="col-5">Km residui</dt><dd class="col-7">@Model.Listing.RemainingKm.ToString("N0")</dd>
                @if (Model.Listing.ExcessKmRate.HasValue) { <dt class="col-5">Costo km in eccesso</dt><dd class="col-7">@Model.Listing.ExcessKmRate.Value.ToString("C2") / km</dd> }
                @if (Model.Listing.UnderKmRate.HasValue) { <dt class="col-5">Rimborso km non percorsi</dt><dd class="col-7">@Model.Listing.UnderKmRate.Value.ToString("C2") / km</dd> }
                @if (Model.Listing.ContributionType != ContributionType.None || Model.Listing.ContributionAmount > 0) { <dt class="col-5">Contributo subentro</dt><dd class="col-7">@Model.Listing.ContributionType · @Model.Listing.ContributionAmount.ToString("C2")</dd> }
            </dl>
            <h3 class="h6 mt-2">Servizi inclusi</h3>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Listing.MaintenanceIncluded) { <span class="badge text-bg-light">Manutenzione</span> }
                @if (Model.Listing.InsuranceIncluded) { <span class="badge text-bg-light">Assicurazione</span> }
                @if (Model.Listing.RoadsideAssistanceIncluded) { <span class="badge text-bg-light">Assistenza stradale</span> }
                @if (Model.Listing.ReplacementCarIncluded) { <span class="badge text-bg-light">Auto sostitutiva</span> }
                @if (Model.Listing.TiresIncluded) { <span class="badge text-bg-light">Pneumatici</span> }
                @if (Model.Listing.RoadTaxIncluded) { <span class="badge text-bg-light">Bollo</span> }
                @if (!Model.Listing.MaintenanceIncluded && !Model.Listing.InsuranceIncluded && !Model.Listing.RoadsideAssistanceIncluded && !Model.Listing.ReplacementCarIncluded && !Model.Listing.TiresIncluded && !Model.Listing.RoadTaxIncluded) { <span class="text-muted">Nessun servizio incluso indicato.</span> }
            </div>
            @if (Model.Listing.InsuranceIncluded && !string.IsNullOrWhiteSpace(Model.Listing.InsuranceKinds)) { <p class="small mt-2 mb-0"><strong>Coperture assicurative:</strong> @Model.Listing.InsuranceKinds</p> }
        </div>
    </div>
    <div class="col-lg-5">
        @if (Model.CanManage && Model.Listing.Status != ListingStatus.Deleted)
        {
            <form method="post" asp-page-handler="SetStatus" class="card card-body"><h2 class="h5">Moderazione</h2><div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" name="id" value="@Model.Listing.Id" />
                <div class="mb-3"><label class="form-label" for="status">Nuovo stato</label><select id="status" name="status" class="form-select" required>
                    <option value="" selected disabled>Stato attuale: @Model.Listing.Status — seleziona un’azione</option>
                    <option value="Active">Disponibile</option><option value="Reserved">Riservato</option><option value="Closed">Chiuso</option><option value="Suspended">Sospeso</option><option value="Withdrawn">Ritirato</option><option value="Deleted">Eliminato</option>
                </select></div>
                <div class="mb-3"><label class="form-label" for="reason">Motivo (obbligatorio per sospensione, ritiro o cancellazione)</label><textarea id="reason" name="reason" class="form-control" maxlength="1000" rows="3" aria-describedby="reason-help">@Model.Listing.StatusReason</textarea><div id="reason-help" class="form-text">Spiega al Dealer cosa correggere o perché l’offerta viene ritirata o eliminata.</div></div>
                <button class="btn btn-primary" type="submit">Aggiorna stato</button>
            </form>
        }
    </div>
</div>
