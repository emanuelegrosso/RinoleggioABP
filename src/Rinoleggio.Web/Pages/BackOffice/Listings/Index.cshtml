@page "/BackOffice/Listings"
@using Rinoleggio.Listings
@model Rinoleggio.Web.Pages.BackOffice.Listings.IndexModel

<h1 class="mb-3">Gestione offerte</h1>
<p class="text-muted">@Model.Listings.TotalCount offerte registrate.</p>

<form method="get" class="card card-body mb-3"><input type="hidden" name="Filter.MaxResultCount" value="@Model.Filter.MaxResultCount" /><input type="hidden" name="Filter.SkipCount" value="0" /><div class="row g-2 align-items-end">
    <div class="col-md-6"><label class="form-label">Cerca</label><input class="form-control" name="Filter.Query" value="@Model.Filter.Query" placeholder="Titolo, marca, modello o società" /></div>
    <div class="col-md-4"><label class="form-label">Stato</label><select class="form-select" name="Filter.Status"><option value="">Tutti gli stati</option>@foreach (ListingStatus status in Enum.GetValues(typeof(ListingStatus))) { <option value="@status" selected="@(Model.Filter.Status == status)">@status</option> }</select></div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Filtra</button></div>
</div></form>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Offerta</th><th>Dealer</th><th>Canone</th><th>Scadenza</th><th>Stato</th></tr></thead>
        <tbody>
        @foreach (var listing in Model.Listings.Items)
        {
            <tr>
                <td><a href="/BackOffice/Listings/Details/@listing.Id">@listing.Title</a><div class="small text-muted">@listing.Brand @listing.Model · @listing.Province</div></td>
                <td><code>@listing.OwnerId</code></td>
                <td>@listing.MonthlyFee.ToString("C0")</td>
                <td>@listing.EndDate.ToString("dd/MM/yyyy")</td>
                <td>@listing.Status@if (!string.IsNullOrWhiteSpace(listing.StatusReason)) { <div class="small text-muted">@listing.StatusReason</div> }</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<nav class="mt-4 d-flex gap-2"><a class="btn btn-outline-secondary @(Model.Filter.SkipCount == 0 ? "disabled" : "")" href="?Filter.SkipCount=@(Math.Max(0, Model.Filter.SkipCount - Model.Filter.MaxResultCount))&Filter.MaxResultCount=@Model.Filter.MaxResultCount&Filter.Query=@Model.Filter.Query&Filter.Status=@Model.Filter.Status">Precedente</a><a class="btn btn-outline-secondary @(Model.Filter.SkipCount + Model.Filter.MaxResultCount >= Model.Listings.TotalCount ? "disabled" : "")" href="?Filter.SkipCount=@(Model.Filter.SkipCount + Model.Filter.MaxResultCount)&Filter.MaxResultCount=@Model.Filter.MaxResultCount&Filter.Query=@Model.Filter.Query&Filter.Status=@Model.Filter.Status">Successiva</a></nav>
