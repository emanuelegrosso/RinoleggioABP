@page
@model Rinoleggio.Web.Pages.IndexModel
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Rinoleggio.Web.Menus
@inject IPageLayout PageLayout
@{
    PageLayout.Content.Title = "Rinoleggio";
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = RinoleggioMenus.Home;
}
<section class="py-5 text-center">
    <h1 class="display-4 fw-bold">Subentra in un noleggio a lungo termine</h1>
    <p class="lead mx-auto" style="max-width: 720px">Trova contratti NLT già avviati, confronta costi e condizioni e invia una richiesta al nostro team.</p>
    <a class="btn btn-primary btn-lg mt-3" href="/Listings">Vai alla ricerca</a>
    <a class="btn btn-outline-secondary btn-lg mt-3 ms-2" href="/ComeFunziona">Come funziona</a>
</section>
<div class="row g-3 mb-5">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">1. Cerca</h2><p>Filtra per veicolo, canone, chilometraggio e scadenza.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">2. Invia una richiesta</h2><p>Contattaci dall’annuncio che ti interessa.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">3. Ti seguiamo</h2><p>Il team coordina i prossimi passi con le parti coinvolte.</p></div></div></div>
</div>
