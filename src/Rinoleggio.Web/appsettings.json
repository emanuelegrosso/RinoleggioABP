{
  "App": {
    "SelfUrl": "https://localhost:44389",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../Rinoleggio.db;"
  },
  "Settings": {
    "Abp.Mailing.DefaultFromDisplayName": "Rinoleggio"
  },
  "AuthServer": {
    "Authority": "https://localhost:44389",
    "RequireHttpsMetadata": true,
    "CertificatePassPhrase": "8a337503-69aa-4e90-8e92-c5791cfc352b"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "CwRaNh9PXnDP0G4V"
  }
}
